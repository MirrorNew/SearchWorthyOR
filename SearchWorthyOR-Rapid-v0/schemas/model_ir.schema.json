{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "searchworthyor.rapid_model_ir.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "variant",
    "family",
    "source_candidate_id",
    "variables",
    "objective",
    "constraints",
    "action_projection"
  ],
  "properties": {
    "schema_version": {"const": "searchworthyor.rapid_model_ir.v0"},
    "id": {"type": "string", "pattern": "^SWOR-R[0-9]{3}$"},
    "variant": {"enum": ["base", "patched"]},
    "family": {"type": "string"},
    "source_candidate_id": {"type": "string", "minLength": 1},
    "variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "lb", "ub", "meaning"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "type": {"enum": ["BINARY", "INTEGER"]},
          "lb": {"type": "integer"},
          "ub": {"type": "integer"},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense", "constant", "coefficients", "meaning", "unit"],
      "properties": {
        "sense": {"enum": ["min", "max"]},
        "constant": {"type": "number"},
        "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sense", "rhs", "coefficients", "meaning"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "sense": {"enum": ["<=", "=", ">="]},
          "rhs": {"type": "number"},
          "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
          "meaning": {"type": "string", "minLength": 1}
        }
      }
    },
    "action_projection": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
    }
  }
}
